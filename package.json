{
  "name": "chainaim-router",
  "version": "0.0.0-iter0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "ChainAim model gateway: one OpenAI-compatible endpoint that routes each request to the right self-hosted or API model.",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "gateway": "node services/gateway/src/main.ts",
    "test": "node scripts/check-deps.ts && node --test \"services/gateway/test/*.test.ts\" \"scripts/test/*.test.ts\" \"test-console/test/*.test.ts\"",
    "check:deps": "node scripts/check-deps.ts",
    "test:engine": "npm --prefix packages/route-engine run check",
    "test:paywall": "npm --prefix services/paywall test",
    "smoke": "node scripts/smoke.ts",
    "stub-models": "node scripts/stub-models.ts",
    "stub-presidio": "node scripts/stub-presidio.ts",
    "stub-openrouter": "node scripts/stub-openrouter.ts",
    "verify:presidio": "node scripts/verify-presidio.ts",
    "verify:openrouter": "node scripts/verify-openrouter.ts",
    "models:start": "scripts/serve-local-models.sh",
    "models:stop": "scripts/serve-local-models.sh --stop",
    "eval:iter0": "node scripts/iter0-matrix.ts",
    "dental": "node services/analyst/scripts/dental.ts",
    "test:erpnext-split": "node --test \"tools/erpnext-split/test/*.test.ts\""
  }
}
