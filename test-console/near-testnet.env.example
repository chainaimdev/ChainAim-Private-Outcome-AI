# Paywall NEAR settings for: .\test-console\stack.ps1 -Rebuild paywall -NearEnvFile C:\PRIV-AI-SECRETS\near-testnet.env
# Copy this file to C:\PRIV-AI-SECRETS\near-testnet.env (outside the repository) and fill the three <...> values there.
# Never put the filled file in the repository. stack.ps1 prints names only, never values.
# Source of the fixed values: docs/NEAR-GATES.md G2 (Circle TestNet USDC on NEAR, 6 decimals).
PAY_RAILS=xrpl,near
NEAR_NETWORK=testnet
NEAR_USDC_CONTRACT_TESTNET=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
NEAR_USDC_DECIMALS_TESTNET=6
# The account every paid call pays (register it with the USDC contract once: node services/paywall/scripts/near-storage.ts).
NEAR_PAY_TO_TESTNET=<pay-to account, e.g. chainaim-payto.testnet>
# The relayer submits the buyer's signed transfer and pays the gas: holds a little TestNet NEAR; must differ from the pay-to account.
NEAR_RELAYER_ACCOUNT_TESTNET=<relayer account, e.g. chainaim-relayer.testnet>
NEAR_RELAYER_KEY_TESTNET=<relayer full-access private key, ed25519:...>
# Optional: leave unset for FastNEAR's public TestNet RPC.
# NEAR_RPC_URL_TESTNET=
