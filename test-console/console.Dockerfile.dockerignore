# Build context for test-console/console.Dockerfile only (BuildKit reads <Dockerfile>.dockerignore instead of the root
# .dockerignore). Everything is left out except what the Dockerfile copies; keys, runs and data never enter the context.
*
!packages/crossask/package.json
!packages/crossask/src
!packages/receipt/package.json
!packages/receipt/src
!packages/ap2/package.json
!packages/ap2/src
!services/web/src/balance.ts
!services/web/src/near-wallets.ts
!config
config/local
config/data-sources.json
!test-console/console
**/node_modules
**/*.env
