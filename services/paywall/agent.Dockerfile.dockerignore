# Build context: the repository root, for services/paywall/agent.Dockerfile only (BuildKit reads <Dockerfile>.dockerignore
# instead of the root .dockerignore). Everything is left out except what the Dockerfile copies; no key, env file, test,
# tenant file or data. Guard: scripts/test/agent-docker.test.ts.
*
!services/paywall/package.json
!services/paywall/package-lock.json
!services/paywall/src
!services/paywall/scripts
!services/web/src/balance.ts
!services/web/src/crossmark-signer.ts
!services/web/src/near-payment.ts
!services/web/src/xrpl-payment.ts
!services/gateway/src/privacy/entities.ts
!services/gateway/src/privacy/presidio.ts
!services/gateway/src/privacy/residual.ts
!packages/agent-policy/package.json
!packages/agent-policy/src
**/node_modules
**/.env
**/*.env
