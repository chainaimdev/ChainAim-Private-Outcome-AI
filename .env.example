# Variable NAMES only. Real values live in your OS keychain or secrets manager
# (on Railway: service variables) and reach each service as environment variables.

# Bearer key shared by the gateway (--api-key-env CHAINAIM_GATEWAY_KEY) and the paywall
CHAINAIM_GATEWAY_KEY=

# Gateway: OpenRouter key for the free chat models and Jev (--model-source openrouter-free)
OPENROUTER_API_KEY=

# Paywall (services/paywall): x402 payments in RLUSD on the XRP Ledger.
# XRPL_NETWORK picks testnet (the default) or mainnet. Every ledger value comes as a
# _TESTNET / _MAINNET pair; only the chosen network's values are read and checked.
XRPL_NETWORK=
# The account every route pays (r...). It needs a trust line to the RLUSD issuer.
XRPL_PAY_TO_TESTNET=
XRPL_PAY_TO_MAINNET=
# RLUSD issuer. TestNet has a default; MainNet has none: copy it from Ripple's documentation at deploy time.
RLUSD_ISSUER_TESTNET=
RLUSD_ISSUER_MAINNET=
# Optional; each has a default (see services/paywall/src/config.ts)
XRPL_CAIP2_TESTNET=
XRPL_CAIP2_MAINNET=
FACILITATOR_URL_TESTNET=
FACILITATOR_URL_MAINNET=
RLUSD_CURRENCY_CODE=
XRPL_SOURCE_TAG=
XRPL_MAX_TIMEOUT_SECONDS=
GATEWAY_URL=
PUBLIC_BASE_URL=
# Price per call in USD, 1 to 6 decimals; each defaults to $0.01 when unset
PRICE_SCAN=
PRICE_MASK=
PRICE_CHAT=

# Paywall payment rails: xrpl (default, RLUSD), near (USDC on NEAR, x402 exact via @x402/near) or xrpl,near.
# Unset = xrpl only, and nothing below in this block is read. See docs/NEAR-GATES.md.
PAY_RAILS=
# NEAR_NETWORK picks testnet (default) or mainnet; only that network's _TESTNET / _MAINNET values are read.
NEAR_NETWORK=
# The NEAR account every route pays; register it with the USDC contract once (scripts/near-storage.ts).
NEAR_PAY_TO_TESTNET=
NEAR_PAY_TO_MAINNET=
# USDC contract id and decimals (Circle: see docs/NEAR-GATES.md, G2); checked against ft_metadata at start.
NEAR_USDC_CONTRACT_TESTNET=
NEAR_USDC_CONTRACT_MAINNET=
NEAR_USDC_DECIMALS_TESTNET=
NEAR_USDC_DECIMALS_MAINNET=
# NEAR JSON-RPC (HTTPS). Default: FastNEAR's public endpoint. A QuickNode URL holds its token: keep it in your private env file.
NEAR_RPC_URL_TESTNET=
NEAR_RPC_URL_MAINNET=
NEAR_RPC_FALLBACK_URL_TESTNET=
NEAR_RPC_FALLBACK_URL_MAINNET=
# Who settles: an x402 facilitator URL, or (when unset) the paywall itself through a relayer account that pays the gas.
NEAR_FACILITATOR_URL_TESTNET=
NEAR_FACILITATOR_URL_MAINNET=
NEAR_RELAYER_ACCOUNT_TESTNET=
NEAR_RELAYER_ACCOUNT_MAINNET=
# The relayer's full-access key (ed25519:...): a secret, private env file only.
NEAR_RELAYER_KEY_TESTNET=
NEAR_RELAYER_KEY_MAINNET=
# Optional: most gas a payer's delegated ft_transfer may ask the relayer to sponsor (default 100 TGas).
NEAR_MAX_GAS=

# Paywall scripts only (services/paywall/scripts): never set on a service, never committed.
# The family seed (s...) of the account that signs: the buyer in pay.ts and private-ask.ts.
XRPL_BUYER_SEED_TESTNET=
XRPL_BUYER_SEED_MAINNET=
# Test rig (scripts/rig.ts): one buyer seed per tenant, named by "seedPrefix" in rig/tenants/<id>/tenant.json.
XRPL_SEED_T01_TESTNET=
XRPL_SEED_T02_TESTNET=
XRPL_SEED_T03_TESTNET=
# The ledger's WebSocket address. TestNet has a default; MainNet has none.
XRPL_WS_URL_TESTNET=
XRPL_WS_URL_MAINNET=
# Web page (services/web): the NEAR wallet visitors may pay with, when the paywall offers USDC on NEAR.
# Only intear-wallet is allowed (docs/NEAR-GATES.md, "Web wallet and CSP"). Unset = no NEAR button and the Crossmark-only CSP.
NEAR_WALLET=

# NEAR buyer (scripts/near-pay.ts, near-storage.ts): the paying account and its full-access key (ed25519:...).
# It needs USDC only; the paywall's relayer pays the gas. near-storage.ts also spends a little NEAR for the deposit.
NEAR_BUYER_ACCOUNT_TESTNET=
NEAR_BUYER_ACCOUNT_MAINNET=
NEAR_BUYER_KEY_TESTNET=
NEAR_BUYER_KEY_MAINNET=
# Test rig --rail near: one key per tenant, named by "near": {"keyEnv"} in rig/tenants/<id>/tenant.json.
NEAR_KEY_T01_TESTNET=
NEAR_KEY_T02_TESTNET=
NEAR_KEY_T03_TESTNET=

# ledger-watch (services/ledger-watch): QuickNode XRPL Testnet endpoints (the token is in the URL path;
# keep the values in your private env file, never here) and the key the admin console sends.
QUICKNODE_XRPL_WSS_TESTNET=
QUICKNODE_XRPL_HTTP_TESTNET=
ADMIN_API_KEY=
# Live ops (Phase 2). The key senders use for ledger-watch POST /ingest (24+ characters, must differ from
# ADMIN_API_KEY; unset = /ingest off). The rig reads it with --trace-url; the paywall's sink sends it as PAYMENT_LOG_KEY.
LEDGER_WATCH_INGEST_KEY=
# Paywall payment log sink: unset (default) = off and the payment_settled line is unchanged.
# PAYMENT_LOG_URL=http://127.0.0.1:8790/ingest/claim
# PAYMENT_LOG_KEY=
# PAYMENT_LOG_FILE=
# PAYMENT_LOG_TIMEOUT_MS=1500
# PAYMENT_LOG_MAX_INFLIGHT=32

# Per-deployment upstream keys, referenced by "apiKeyEnv" in config/catalog.json
# CHAINAIM_OPENAI_KEY=
# CHAINAIM_ANTHROPIC_KEY=
# CHAINAIM_GPU_CLOUD_KEY=
